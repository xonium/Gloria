<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Gloria.ViewModels"
             x:Class="Gloria.Pages.ComparePage"
             x:DataType="vm:CompareViewModel"
             Title="Compare">

    <ScrollView>
        <VerticalStackLayout Padding="40,32,40,48" Spacing="20">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <VerticalStackLayout Spacing="6">
                    <HorizontalStackLayout Spacing="14">
                        <Label Text="Compare with" Style="{StaticResource H1}" SemanticProperties.HeadingLevel="Level1" VerticalOptions="Center" />
                        <Picker ItemsSource="{Binding TargetNames}" SelectedIndex="{Binding SelectedTargetIndex}" MinimumWidthRequest="220" VerticalOptions="Center"
                                SemanticProperties.Description="Player to compare with" />
                    </HorizontalStackLayout>
                    <Label Text="{Binding Subtitle}" Style="{StaticResource Sub}" FontSize="15" />
                </VerticalStackLayout>
                <Border Grid.Column="1" BackgroundColor="#111316" Stroke="{StaticResource Line}" StrokeShape="RoundRectangle 9" Padding="3" VerticalOptions="End">
                    <HorizontalStackLayout Spacing="2" BindableLayout.ItemsSource="{Binding Periods}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:ChoiceOption">
                                <Button Text="{Binding Label}" Command="{Binding SelectCommand}" BackgroundColor="{Binding Background}" TextColor="{Binding Foreground}" BorderWidth="0" MinimumHeightRequest="34" Padding="12,0" FontSize="13" SemanticProperties.Description="{Binding Label, StringFormat='Period: {0} demos'}" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" IsVisible="{Binding IsEmpty}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                    <Label Text="{Binding EmptyText}" Style="{StaticResource Sub}" VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="Player" Style="{StaticResource GhostButton}" Command="{Binding PickPlayerCommand}" />
                </Grid>
            </Border>

            <VerticalStackLayout Spacing="20" IsVisible="{Binding HasData}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                        <Label Text="{Binding SourceNote}" Style="{StaticResource Caption}" />
                        <Label Text="{Binding SampleNote}" TextColor="{StaticResource WarnText}" FontSize="13" IsVisible="{Binding HasSampleNote}" />
                    </VerticalStackLayout>
                    <Border Grid.Column="1" BackgroundColor="#111316" Stroke="{StaticResource Line}" StrokeShape="RoundRectangle 9" Padding="3" VerticalOptions="Center">
                        <HorizontalStackLayout Spacing="2" BindableLayout.ItemsSource="{Binding Weapons}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:ChoiceOption">
                                    <Button Text="{Binding Label}" Command="{Binding SelectCommand}" BackgroundColor="{Binding Background}" TextColor="{Binding Foreground}" BorderWidth="0" MinimumHeightRequest="34" Padding="12,0" FontSize="13" SemanticProperties.Description="{Binding Label, StringFormat='Weapons: {0}'}" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </Border>
                </Grid>

                <Grid ColumnDefinitions="3*,2*" ColumnSpacing="16">
                    <Border Style="{StaticResource Card}" VerticalOptions="Start">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Where you lose the most ground" Style="{StaticResource H2}" SemanticProperties.HeadingLevel="Level2" />
                            <Label Text="The largest differences in how you aim and move, worst first. Duels won and reaction times are left out here: they depend on who you play against." Style="{StaticResource Caption}" FontSize="13" />
                            <Label Text="Nothing stands out: you are within a couple of points everywhere." Style="{StaticResource Caption}" FontSize="13" IsVisible="{Binding NothingBehind}" />
                            <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Behind}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:GapItem">
                                        <Border Style="{StaticResource InnerCard}" Stroke="{StaticResource Line}" StrokeThickness="1">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                                                <VerticalStackLayout Spacing="3">
                                                    <Label Text="{Binding Name}" FontFamily="OpenSansSemibold" FontSize="15" />
                                                    <Label Text="{Binding Values}" />
                                                    <Label Text="{Binding Description}" Style="{StaticResource Caption}" />
                                                </VerticalStackLayout>
                                                <Label Grid.Column="1" Text="{Binding Difference}" TextColor="{Binding DifferenceColor}" FontFamily="OpenSansSemibold" VerticalOptions="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}" VerticalOptions="Start" IsVisible="{Binding HasAhead}">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Where you hold up" Style="{StaticResource H2}" SemanticProperties.HeadingLevel="Level2" />
                            <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Ahead}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:GapItem">
                                        <Border Style="{StaticResource InnerCard}" Stroke="{StaticResource Line}" StrokeThickness="1">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                                                <VerticalStackLayout Spacing="3">
                                                    <Label Text="{Binding Name}" FontFamily="OpenSansSemibold" FontSize="15" />
                                                    <Label Text="{Binding Values}" />
                                                    <Label Text="{Binding Description}" Style="{StaticResource Caption}" />
                                                </VerticalStackLayout>
                                                <Label Grid.Column="1" Text="{Binding Difference}" TextColor="{Binding DifferenceColor}" FontFamily="OpenSansSemibold" VerticalOptions="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Side by side" Style="{StaticResource H2}" SemanticProperties.HeadingLevel="Level2" />
                        <Grid ColumnDefinitions="*,110,110,160" ColumnSpacing="12" Padding="8,6">
                            <Label Text="Metric" Style="{StaticResource Overline}" />
                            <Label Grid.Column="1" Text="You" Style="{StaticResource Overline}" HorizontalTextAlignment="End" />
                            <Label Grid.Column="2" Text="{Binding ThemName}" Style="{StaticResource Overline}" HorizontalTextAlignment="End" LineBreakMode="TailTruncation" />
                            <Label Grid.Column="3" Text="Difference" Style="{StaticResource Overline}" HorizontalTextAlignment="End" />
                        </Grid>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Rows}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:CompareRow">
                                    <VerticalStackLayout>
                                        <BoxView Style="{StaticResource Divider}" />
                                        <Grid ColumnDefinitions="*,110,110,160" ColumnSpacing="12" Padding="8,10">
                                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                                <Label Text="{Binding Name}" FontFamily="OpenSansSemibold" />
                                                <Label Text="{Binding Foot}" Style="{StaticResource Caption}" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="1" Text="{Binding You}" FontFamily="OpenSansSemibold" HorizontalTextAlignment="End" VerticalOptions="Center" />
                                            <Label Grid.Column="2" Text="{Binding Them}" TextColor="{StaticResource Text2}" HorizontalTextAlignment="End" VerticalOptions="Center" />
                                            <Label Grid.Column="3" Text="{Binding Difference}" TextColor="{Binding DifferenceColor}" HorizontalTextAlignment="End" VerticalOptions="Center" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <Label Text="Duels won and reaction times depend on the opposition, so they compare least fairly with someone who plays in other matches. Habits, moving shots and pre-aim compare more fairly." Style="{StaticResource Caption}" />
                    </VerticalStackLayout>
                </Border>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                    <Border Style="{StaticResource Card}" VerticalOptions="Start">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Aim habits" Style="{StaticResource H2}" SemanticProperties.HeadingLevel="Level2" />
                                <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                    <BoxView WidthRequest="2" HeightRequest="12" Color="#d6d7da" />
                                    <Label Text="{Binding ThemName}" Style="{StaticResource Caption}" />
                                </HorizontalStackLayout>
                            </Grid>
                            <Label Text="Share of encounters flagged with each habit: the bar is you, the marker them. Both are judged by the same aim model." Style="{StaticResource Caption}" FontSize="13" />
                            <VerticalStackLayout Spacing="4" BindableLayout.ItemsSource="{Binding Habits}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CompareBarItem">
                                        <Grid ColumnDefinitions="*,160,96" ColumnSpacing="14" MinimumHeightRequest="52" Padding="0,4">
                                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                                <Label Text="{Binding Name}" FontFamily="OpenSansSemibold" />
                                                <Label Text="{Binding Description}" Style="{StaticResource Caption}" />
                                            </VerticalStackLayout>
                                            <AbsoluteLayout Grid.Column="1" HeightRequest="14" VerticalOptions="Center" BackgroundColor="#24272c">
                                                <BoxView Color="{StaticResource Accent}" AbsoluteLayout.LayoutFlags="All" AbsoluteLayout.LayoutBounds="{Binding YouBar}" />
                                                <BoxView Color="#d6d7da" AbsoluteLayout.LayoutFlags="XProportional,HeightProportional" AbsoluteLayout.LayoutBounds="{Binding ThemBar}" />
                                            </AbsoluteLayout>
                                            <VerticalStackLayout Grid.Column="2" Spacing="0" VerticalOptions="Center">
                                                <Label Text="{Binding You}" FontFamily="OpenSansSemibold" HorizontalTextAlignment="End" />
                                                <Label Text="{Binding Them}" Style="{StaticResource Caption}" HorizontalTextAlignment="End" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}" VerticalOptions="Start">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="What costs the duels you lose" Style="{StaticResource H2}" SemanticProperties.HeadingLevel="Level2" />
                            <Label Text="{Binding CausesNote}" Style="{StaticResource Caption}" FontSize="13" />
                            <HorizontalStackLayout Spacing="14" IsVisible="{Binding HasCauses}">
                                <HorizontalStackLayout Spacing="6">
                                    <BoxView WidthRequest="12" HeightRequest="8" Color="{StaticResource Accent}" VerticalOptions="Center" />
                                    <Label Text="You" Style="{StaticResource Caption}" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="6">
                                    <BoxView WidthRequest="12" HeightRequest="8" Color="#d6d7da" VerticalOptions="Center" />
                                    <Label Text="{Binding ThemName}" Style="{StaticResource Caption}" />
                                </HorizontalStackLayout>
                            </HorizontalStackLayout>
                            <VerticalStackLayout Spacing="4" BindableLayout.ItemsSource="{Binding Causes}" IsVisible="{Binding HasCauses}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CompareBarItem">
                                        <Grid ColumnDefinitions="*,140,56" ColumnSpacing="14" MinimumHeightRequest="52" Padding="0,4">
                                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                                <Label Text="{Binding Name}" FontFamily="OpenSansSemibold" />
                                                <Label Text="{Binding Description}" Style="{StaticResource Caption}" />
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                                <AbsoluteLayout HeightRequest="8">
                                                    <BoxView Color="{StaticResource Accent}" AbsoluteLayout.LayoutFlags="All" AbsoluteLayout.LayoutBounds="{Binding YouBar}" />
                                                </AbsoluteLayout>
                                                <AbsoluteLayout HeightRequest="8">
                                                    <BoxView Color="#d6d7da" AbsoluteLayout.LayoutFlags="All" AbsoluteLayout.LayoutBounds="{Binding ThemBar}" />
                                                </AbsoluteLayout>
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="2" Spacing="0" VerticalOptions="Center">
                                                <Label Text="{Binding You}" FontFamily="OpenSansSemibold" HorizontalTextAlignment="End" />
                                                <Label Text="{Binding Them}" Style="{StaticResource Caption}" HorizontalTextAlignment="End" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
