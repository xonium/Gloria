<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Gloria.ViewModels"
             x:Class="Gloria.Pages.SprayPage"
             x:DataType="vm:SprayViewModel"
             Title="Spray">

    <ScrollView>
        <VerticalStackLayout Padding="40,32,40,48" Spacing="20">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Spray control" Style="{StaticResource H1}" SemanticProperties.HeadingLevel="Level1" />
                    <FlexLayout Wrap="Wrap" AlignItems="Center">
                        <HorizontalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Players}" IsVisible="{Binding IsMulti}" Margin="0,0,8,0">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:PlayerChip">
                                    <Border BackgroundColor="#111316" Stroke="{StaticResource Line}" StrokeShape="RoundRectangle 9" Padding="{Binding ChipPadding}" HeightRequest="38">
                                        <HorizontalStackLayout Spacing="8">
                                            <Ellipse Fill="{Binding Color}" WidthRequest="10" HeightRequest="10" VerticalOptions="Center" />
                                            <Label Text="{Binding Name}" FontFamily="OpenSansSemibold" FontSize="13" VerticalOptions="Center" />
                                            <Label Text="{Binding Detail}" Style="{StaticResource Caption}" VerticalOptions="Center" />
                                            <Button Text="✕" IsVisible="{Binding CanRemove}" Command="{Binding RemoveCommand}" BackgroundColor="Transparent" TextColor="{StaticResource Muted}" BorderWidth="0" FontSize="12" Padding="8,0" MinimumWidthRequest="0" MinimumHeightRequest="30" VerticalOptions="Center"
                                                    SemanticProperties.Description="{Binding RemoveDescription}" />
                                        </HorizontalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                        <Button Text="+ Add player" Style="{StaticResource GhostButton}" Command="{Binding AddCommand}" IsVisible="{Binding CanAdd}" MinimumHeightRequest="36" FontSize="13" VerticalOptions="Center" Margin="0,1"
                                SemanticProperties.Description="Add a player to compare" />
                    </FlexLayout>
                    <Label Text="{Binding Subtitle}" Style="{StaticResource Sub}" FontSize="15" />
                </VerticalStackLayout>
                <Border Grid.Column="1" BackgroundColor="#111316" Stroke="{StaticResource Line}" StrokeShape="RoundRectangle 9" Padding="3" VerticalOptions="End">
                    <HorizontalStackLayout Spacing="2" BindableLayout.ItemsSource="{Binding Periods}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:ChoiceOption">
                                <Button Text="{Binding Label}" Command="{Binding SelectCommand}" BackgroundColor="{Binding Background}" TextColor="{Binding Foreground}" BorderWidth="0" MinimumHeightRequest="34" Padding="12,0" FontSize="13" SemanticProperties.Description="{Binding Label, StringFormat='Period: {0} demos'}" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" IsVisible="{Binding IsEmpty}">
                <Label Text="{Binding EmptyText}" Style="{StaticResource Sub}" />
            </Border>

            <Border Style="{StaticResource Card}" Padding="22,18" IsVisible="{Binding HasData}">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="12">
                        <Image Source="{Binding GunIcon}" IsVisible="{Binding HasGunIcon}" HeightRequest="26" Aspect="AspectFit" VerticalOptions="Center" />
                        <Picker Grid.Column="1" ItemsSource="{Binding GunNames}" SelectedIndex="{Binding SelectedGunIndex}" MinimumWidthRequest="200" VerticalOptions="Center"
                                SemanticProperties.Description="Gun" />
                        <Label Grid.Column="2" Text="{Binding GunNote}" Style="{StaticResource Caption}" FontSize="13" VerticalOptions="Center" />
                    </Grid>
                    <HorizontalStackLayout Spacing="22">
                        <HorizontalStackLayout Spacing="8">
                            <BoxView Color="{StaticResource Muted}" WidthRequest="22" HeightRequest="2" VerticalOptions="Center" />
                            <Label Text="Sprays that reached the bullet" Style="{StaticResource Caption}" FontSize="13" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="8">
                            <HorizontalStackLayout Spacing="3" VerticalOptions="Center">
                                <BoxView Color="{StaticResource Muted}" WidthRequest="6" HeightRequest="2" />
                                <BoxView Color="{StaticResource Muted}" WidthRequest="6" HeightRequest="2" />
                                <BoxView Color="{StaticResource Muted}" WidthRequest="6" HeightRequest="2" />
                            </HorizontalStackLayout>
                            <Label Text="Hit rate of the bullet" Style="{StaticResource Caption}" FontSize="13" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="▼" TextColor="{StaticResource Muted}" FontSize="12" VerticalOptions="Center" />
                            <Label Text="Bullet that killed most often" Style="{StaticResource Caption}" FontSize="13" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </HorizontalStackLayout>
                    <GraphicsView Drawable="{Binding Chart}" HeightRequest="340" SemanticProperties.Description="Spray chart" />
                    <Label Text="Bullet in the spray" Style="{StaticResource Caption}" HorizontalOptions="Center" />

                    <BoxView Style="{StaticResource Divider}" Margin="0,8,0,0" />
                    <Grid ColumnDefinitions="*,110,130,100,110,150" ColumnSpacing="8" Padding="8,6">
                        <Label Text="Player" Style="{StaticResource Overline}" />
                        <Label Grid.Column="1" Text="Sprays" Style="{StaticResource Overline}" HorizontalTextAlignment="End" />
                        <Label Grid.Column="2" Text="Median length" Style="{StaticResource Overline}" HorizontalTextAlignment="End" />
                        <Label Grid.Column="3" Text="Hit rate" Style="{StaticResource Overline}" HorizontalTextAlignment="End" />
                        <Label Grid.Column="4" Text="First bullet" Style="{StaticResource Overline}" HorizontalTextAlignment="End" />
                        <Label Grid.Column="5" Text="Most kills on" Style="{StaticResource Overline}" HorizontalTextAlignment="End" />
                    </Grid>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Rows}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:SprayRow">
                                <Grid ColumnDefinitions="*,110,130,100,110,150" ColumnSpacing="8" Padding="8,8">
                                    <HorizontalStackLayout Spacing="8">
                                        <Ellipse Fill="{Binding Color}" WidthRequest="8" HeightRequest="8" VerticalOptions="Center" />
                                        <Label Text="{Binding Player}" FontFamily="OpenSansSemibold" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                    <Label Grid.Column="1" Text="{Binding Sprays}" HorizontalTextAlignment="End" />
                                    <Label Grid.Column="2" Text="{Binding MedianLength}" HorizontalTextAlignment="End" />
                                    <Label Grid.Column="3" Text="{Binding HitRate}" HorizontalTextAlignment="End" />
                                    <Label Grid.Column="4" Text="{Binding FirstBullet}" HorizontalTextAlignment="End" />
                                    <Label Grid.Column="5" Text="{Binding KillBullet}" HorizontalTextAlignment="End" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Label Text="{Binding Explanation}" Style="{StaticResource Caption}" FontSize="13" LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
