<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Gloria.Controls"
             x:Class="Gloria.Pages.WelcomePage"
             Title="Welcome">

    <ScrollView>
        <VerticalStackLayout Padding="48,48,48,32" Spacing="36" MaximumWidthRequest="1080" HorizontalOptions="Fill">

            <HorizontalStackLayout Spacing="12">
                <Border StrokeThickness="0" StrokeShape="RoundRectangle 7" VerticalOptions="Center">
                    <Image Source="logo.png" WidthRequest="34" HeightRequest="34" />
                </Border>
                <Label Text="Gloria" FontFamily="OpenSansSemibold" FontSize="22" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <VerticalStackLayout Spacing="14" MaximumWidthRequest="720" HorizontalOptions="Start">
                <Label Text="See how you aim, fight by fight" Style="{StaticResource H1}" FontSize="40" SemanticProperties.HeadingLevel="Level1" />
                <Label Style="{StaticResource Sub}" FontSize="16" LineHeight="1.3"
                       Text="Gloria reads your CS2 demos and breaks every match into the moments you fought someone. For each one it shows whether you overshot, stopped before shooting, or fired too early, and tracks whether that is getting better." />
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="20">
                <Border Style="{StaticResource Card}" Padding="28">
                    <VerticalStackLayout Spacing="20">
                        <Label Text="Start with your demos" Style="{StaticResource H2}" SemanticProperties.HeadingLevel="Level2" />
                        <controls:DemoDropZone DemosChosen="OnDemosChosen" />
                        <FlexLayout Wrap="Wrap" JustifyContent="Start">
                            <Button Text="Choose a demo folder…" Style="{StaticResource PrimaryButton}" Clicked="OnPickFolder" Margin="0,0,10,10" />
                            <Button Text="Use the CS2 replays folder" Style="{StaticResource GhostButton}" Clicked="OnUseReplays" MinimumHeightRequest="44" Margin="0,0,0,10" />
                        </FlexLayout>
                        <Label x:Name="StatusLabel" IsVisible="False" TextColor="{StaticResource WarnText}" FontSize="13" />
                        <Label Style="{StaticResource Caption}" FontSize="13" LineHeight="1.3"
                               Text="Demos you download in CS2 usually land in …\Counter-Strike Global Offensive\game\csgo\replays. Each demo is read once; you can keep using the app meanwhile." />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1" BackgroundColor="{StaticResource Sidebar}" Stroke="#22252a" StrokeShape="RoundRectangle 12" Padding="28">
                    <VerticalStackLayout Spacing="18">
                        <Label Text="What happens next" Style="{StaticResource H2}" SemanticProperties.HeadingLevel="Level2" />
                        <Grid ColumnDefinitions="32,*" ColumnSpacing="14" RowDefinitions="Auto,Auto,Auto" RowSpacing="18">
                            <Border StrokeThickness="0" BackgroundColor="{StaticResource AccentSoft}" StrokeShape="RoundRectangle 16" HeightRequest="32" VerticalOptions="Start">
                                <Label Text="1" TextColor="{StaticResource AccentLight}" FontFamily="OpenSansSemibold" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="Gloria reads the demos" Style="{StaticResource H3}" />
                                <Label Style="{StaticResource Sub}" Text="Every player in every match is analyzed once and saved. The demo files themselves are never changed or moved." />
                            </VerticalStackLayout>
                            <Border Grid.Row="1" StrokeThickness="0" BackgroundColor="{StaticResource AccentSoft}" StrokeShape="RoundRectangle 16" HeightRequest="32" VerticalOptions="Start">
                                <Label Text="2" TextColor="{StaticResource AccentLight}" FontFamily="OpenSansSemibold" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="4">
                                <Label Text="You pick which player is you" Style="{StaticResource H3}" />
                                <Label Style="{StaticResource Sub}" Text="From the players found, or by pasting your SteamID. You can track friends as separate profiles later." />
                            </VerticalStackLayout>
                            <Border Grid.Row="2" StrokeThickness="0" BackgroundColor="{StaticResource AccentSoft}" StrokeShape="RoundRectangle 16" HeightRequest="32" VerticalOptions="Start">
                                <Label Text="3" TextColor="{StaticResource AccentLight}" FontFamily="OpenSansSemibold" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Row="2" Grid.Column="1" Spacing="4">
                                <Label Text="You review your fights" Style="{StaticResource H3}" />
                                <Label Style="{StaticResource Sub}" Text="From trends across matches down to a replay of a single encounter." />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <BoxView Style="{StaticResource Divider}" />
            <FlexLayout Wrap="Wrap" JustifyContent="SpaceBetween" AlignItems="Center">
                <Label Style="{StaticResource Caption}" FontSize="13" Text="Everything stays on this PC. Results are saved in %LocalAppData%\Gloria.Data." Margin="0,0,0,8" />
                <HorizontalStackLayout Spacing="12">
                    <Label x:Name="VersionLabel" Style="{StaticResource Caption}" FontSize="13" VerticalOptions="Center" />
                    <Button x:Name="UpdateButton" Text="Check for updates" Style="{StaticResource GhostButton}" Clicked="OnCheckUpdates" MinimumHeightRequest="34" FontSize="13" />
                </HorizontalStackLayout>
            </FlexLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
