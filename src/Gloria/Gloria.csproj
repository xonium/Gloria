<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Windows only: no Android/iOS/MacCatalyst targets, so builds need no mobile toolchains. -->
		<TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
		<SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>

		<OutputType>WinExe</OutputType>
		<RootNamespace>Gloria</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>

		<!-- Generate C# from XAML at compile time instead of inflating it at runtime. -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<ApplicationTitle>Gloria</ApplicationTitle>
		<ApplicationId>com.gloria.app</ApplicationId>
		<ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- Velopack: unpackaged (no MSIX) and self-contained, including the Windows App SDK. -->
		<WindowsPackageType>None</WindowsPackageType>
		<WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
		<SelfContained>true</SelfContained>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>

		<!-- Platforms/Windows/Program.cs supplies Main so Velopack runs before WinUI starts. -->
		<DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" />
		<PackageReference Include="Velopack" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Gloria.Core\Gloria.Core.csproj" />
		<ProjectReference Include="..\Gloria.Data\Gloria.Data.csproj" />
	</ItemGroup>

</Project>
