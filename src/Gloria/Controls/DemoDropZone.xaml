<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Gloria.Controls.DemoDropZone">

    <Border BackgroundColor="#131417" Stroke="#4a4e57" StrokeThickness="1.5" StrokeDashArray="4,3"
            StrokeShape="RoundRectangle 12" Padding="24" MinimumHeightRequest="170"
            SemanticProperties.Description="Drop demo files here, or click to choose files">
        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnPickFiles" />
            <DropGestureRecognizer AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop" />
        </Border.GestureRecognizers>
        <VerticalStackLayout Spacing="8" VerticalOptions="Center" HorizontalOptions="Center">
            <Label Text="Drop .dem files or folders here" FontFamily="OpenSansSemibold" FontSize="16" HorizontalTextAlignment="Center" />
            <Label Text="or click to pick files · many at once is fine" Style="{StaticResource Caption}" FontSize="13" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </Border>
</ContentView>
